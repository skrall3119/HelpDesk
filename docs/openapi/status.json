{
  "openapi": "3.1.0",
  "info": {
    "title": "CaseLantern Ticket status API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{tenant}.{domain}/api/v1",
      "variables": {
        "tenant": {
          "default": "acme"
        },
        "domain": {
          "default": "example.com"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/tickets/{ticket}/status": {
      "post": {
        "summary": "Change ticket status with a workflow reason",
        "description": "Change ticket status with a workflow reason",
        "parameters": [
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "example": "42"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Change ticket status with a workflow reason",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$",
                          "example": "42"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "open",
                            "in_progress",
                            "waiting_on_client",
                            "on_hold",
                            "closed"
                          ]
                        },
                        "assigned_user_id": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[1-9][0-9]*$",
                              "example": "42"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "closed_at": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time",
                              "example": "2026-11-17T12:00:00.123456Z"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2026-11-17T12:00:00.123456Z"
                        }
                      },
                      "required": [
                        "id",
                        "status",
                        "assigned_user_id",
                        "closed_at",
                        "updated_at"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                },
                "example": {
                  "data": {
                    "id": "44",
                    "status": "closed",
                    "assigned_user_id": "7",
                    "closed_at": "2026-11-17T12:00:00.123456Z",
                    "updated_at": "2026-11-17T12:00:00.123456Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or wrong tenant token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Capability denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing, deleted, or cross-tenant record; invalid tenant host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write or invariant conflict; reload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 128 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or unsupported fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Generic server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "in_progress",
                      "waiting_on_client",
                      "on_hold",
                      "closed"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "updated_at": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-11-17T12:00:00.123456Z"
                  }
                },
                "required": [
                  "status",
                  "updated_at"
                ]
              },
              "example": {
                "status": "closed",
                "reason": "Replaced failed network cable",
                "updated_at": "2026-11-17T12:00:00.123456Z"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
