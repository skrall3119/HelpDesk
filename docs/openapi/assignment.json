                    "type": "string",
                    "format": "date-time",
                    "example": "2026-11-17T12:00:00.123456Z"
                  }
                },
                "required": [
                  "assigned_user_id",
                  "updated_at"
                ]
              },
              "example": {
                "assigned_user_id": "7",
                "updated_at": "2026-11-17T12:00:00.123456Z"
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket}/unassign": {
      "post": {
        "summary": "Unassign a ticket as manager or administrator",
        "description": "Unassign a ticket as manager or administrator",
        "parameters": [
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "example": "42"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unassign a ticket as manager or administrator",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$",
                          "example": "42"
                        },
                        "assigned_user_id": {
                          "anyOf": [
                            {
                              "type": "string",
