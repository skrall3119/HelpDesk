{
  "openapi": "3.1.0",
  "info": {
    "title": "CaseLantern Ticket assignment API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{tenant}.{domain}/api/v1",
      "variables": {
        "tenant": {
          "default": "acme"
        },
        "domain": {
          "default": "example.com"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/assignees": {
      "get": {
        "summary": "List active eligible assignees",
        "description": "List active eligible assignees",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List active eligible assignees",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[1-9][0-9]*$",
                            "example": "42"
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "administrator",
                              "manager",
                              "technician"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "role"
                        ]
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "current_page",
                        "per_page",
                        "last_page",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
                "example": {
                  "data": [
                    {
                      "id": "7",
                      "name": "Example employee",
                      "role": "technician"
                    }
                  ],
                  "meta": {
                    "current_page": 1,
                    "per_page": 25,
                    "total": 1,
                    "last_page": 1
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or wrong tenant token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Capability denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing, deleted, or cross-tenant record; invalid tenant host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write or invariant conflict; reload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 128 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or unsupported fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Generic server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket}/claim": {
      "post": {
        "summary": "Atomically claim an unassigned ticket for the current employee",
        "description": "Atomically claim an unassigned ticket for the current employee",
        "parameters": [
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "example": "42"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Atomically claim an unassigned ticket for the current employee",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$",
                          "example": "42"
                        },
                        "assigned_user_id": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[1-9][0-9]*$",
                              "example": "42"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "open",
                            "in_progress",
                            "waiting_on_client",
                            "on_hold",
                            "closed"
                          ]
                        },
                        "closed_at": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time",
                              "example": "2026-11-17T12:00:00.123456Z"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2026-11-17T12:00:00.123456Z"
                        }
                      },
                      "required": [
                        "id",
                        "assigned_user_id",
                        "status",
                        "closed_at",
                        "updated_at"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                },
                "example": {
                  "data": {
                    "id": "44",
                    "assigned_user_id": "7",
                    "status": "open",
                    "closed_at": null,
                    "updated_at": "2026-11-17T12:00:00.123456Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or wrong tenant token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Capability denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing, deleted, or cross-tenant record; invalid tenant host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write or invariant conflict; reload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "assigned_user_id"
                  ],
                  "properties": {
                    "code": {
                      "const": "conflict"
                    },
                    "message": {
                      "type": "string"
                    },
                    "assigned_user_id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    }
                  }
                },
                "example": {
                  "code": "conflict",
                  "message": "Ticket is already assigned.",
                  "assigned_user_id": "7"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 128 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or unsupported fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Generic server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              },
              "example": {}
            }
          }
        }
      }
    },
