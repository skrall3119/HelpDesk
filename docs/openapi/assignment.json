                          ]
                        },
                        "closed_at": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time",
                              "example": "2026-11-17T12:00:00.123456Z"
                            },
                            {
                              "type": "null"
                            }
                          ]
