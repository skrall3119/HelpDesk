{
  "openapi": "3.1.0",
  "info": {
    "title": "CaseLantern Organization settings API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{tenant}.{domain}/api/v1",
      "variables": {
        "tenant": {
          "default": "acme"
        },
        "domain": {
          "default": "example.com"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/admin/settings": {
      "get": {
        "summary": "Read organization display name",
        "description": "Read organization display name",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Read organization display name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$",
                          "example": "42"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2026-11-17T12:00:00.123456Z"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "updated_at"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                },
                "example": {
                  "data": {
                    "id": "7",
                    "name": "Example support",
                    "updated_at": "2026-11-17T12:00:00.123456Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or wrong tenant token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Capability denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing, deleted, or cross-tenant record; invalid tenant host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write or invariant conflict; reload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 128 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or unsupported fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Generic server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Change organization display name",
        "description": "Change organization display name",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Change organization display name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$",
                          "example": "42"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2026-11-17T12:00:00.123456Z"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "updated_at"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                },
                "example": {
                  "data": {
                    "id": "7",
                    "name": "Updated support",
                    "updated_at": "2026-11-17T12:00:00.123456Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or wrong tenant token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Capability denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing, deleted, or cross-tenant record; invalid tenant host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write or invariant conflict; reload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 128 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or unsupported fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Generic server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "updated_at": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-11-17T12:00:00.123456Z"
                  }
                },
                "required": [
                  "name",
                  "updated_at"
                ]
              },
              "example": {
                "name": "Updated support",
                "updated_at": "2026-11-17T12:00:00.123456Z"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
