{
  "openapi": "3.1.0",
  "info": {
    "title": "CaseLantern Internal comments and revisions API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{tenant}.{domain}/api/v1",
      "variables": {
        "tenant": {
          "default": "acme"
        },
        "domain": {
          "default": "example.com"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/tickets/{ticket}/comments": {
      "get": {
        "summary": "Read the bounded comment timeline",
        "description": "Read the bounded comment timeline",
        "parameters": [
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "example": "42"
            }
          },
          {
            "name": "deleted",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "deleted_ticket",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Read the bounded comment timeline",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[1-9][0-9]*$",
                            "example": "42"
                          },
                          "ticket_id": {
                            "type": "string",
                            "pattern": "^[1-9][0-9]*$",
                            "example": "42"
                          },
                          "user_id": {
                            "type": "string",
                            "pattern": "^[1-9][0-9]*$",
                            "example": "42"
                          },
                          "body": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 20000
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2026-11-17T12:00:00.123456Z"
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2026-11-17T12:00:00.123456Z"
                          },
                          "deleted_at": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time",
                                "example": "2026-11-17T12:00:00.123456Z"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "deleted_by_user_id": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[1-9][0-9]*$",
                                "example": "42"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "ticket_id",
                          "user_id",
                          "body",
                          "created_at",
                          "updated_at",
                          "deleted_at",
                          "deleted_by_user_id"
                        ]
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "current_page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "last_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "current_page",
                        "per_page",
                        "last_page",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
                "example": {
                  "data": [
                    {
                      "id": "45",
                      "ticket_id": "44",
                      "user_id": "7",
                      "body": "Investigation notes",
                      "created_at": "2026-11-17T12:00:00.123456Z",
                      "updated_at": "2026-11-17T12:00:00.123456Z",
                      "deleted_at": null,
                      "deleted_by_user_id": null
                    }
                  ],
                  "meta": {
                    "current_page": 1,
                    "per_page": 25,
                    "total": 1,
                    "last_page": 1
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated or wrong tenant token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Capability denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing, deleted, or cross-tenant record; invalid tenant host",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write or invariant conflict; reload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 128 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or unsupported fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Generic server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
